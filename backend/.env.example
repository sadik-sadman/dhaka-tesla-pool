# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string. In docker-compose this matches the `db` service;
# for local (non-Docker) dev, point it at any Postgres instance you have.
DATABASE_URL="postgresql://tesla_pool:tesla_pool_dev_password@localhost:5432/tesla_pool?schema=public"

# Symmetric secret used to sign JWTs. Generate a real random value for any
# real deployment, e.g.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="1d"

PORT=4000
NODE_ENV=development
